package main

import "fmt"

// Item represents a military supply item.
type Item struct {
	ID           string
	Name         string
	StockLevel   int
	ReorderPoint int
}

// CanSell checks if we have enough stock.
func (i *Item) CanSell(quantity int) bool {
	return i.StockLevel >= quantity
}

// AdjustStock changes stock. Never allows negative stock.
func (i *Item) AdjustStock(quantity int) bool {
	if quantity < 0 && i.StockLevel+quantity < 0 {
		return false
	}
	i.StockLevel = i.StockLevel + quantity
	return true
}

func main() {
	ammoCrate := Item{
		ID:           "AMMO-556-001",
		Name:         "5.56mm Ammo Crate",
		StockLevel:   100,
		ReorderPoint: 50,
	}

	fmt.Println("=== AegisLog Inventory Check ===")
	fmt.Printf("Item: %s\n", ammoCrate.Name)
	fmt.Printf("Current Stock: %d\n", ammoCrate.StockLevel)
	fmt.Println("----------------------------------")

	canSell30 := ammoCrate.CanSell(30)
	fmt.Printf("Can sell 30? %t\n", canSell30)

	canSell150 := ammoCrate.CanSell(150)
	fmt.Printf("Can sell 150? %t\n", canSell150)

	fmt.Println("----------------------------------")

	success := ammoCrate.AdjustStock(-30)
	if success {
		fmt.Printf("Successfully sold 30. New Stock: %d\n", ammoCrate.StockLevel)
	} else {
		fmt.Println("Failed to sell 30.")
	}

	fmt.Println("\nTrying to sell 80 more...")
	success2 := ammoCrate.AdjustStock(-80)
	if success2 {
		fmt.Printf("Successfully sold 80. New Stock: %d\n", ammoCrate.StockLevel)
	} else {
		fmt.Printf("FAILED: Not enough stock. Current Stock is %d\n", ammoCrate.StockLevel)
	}

	fmt.Println("\nRestocking 200 rounds...")
	ammoCrate.AdjustStock(200)
	fmt.Printf("Restock complete. New Stock: %d\n", ammoCrate.StockLevel)
}

